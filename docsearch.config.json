{
  "index_name": "tiptap_v3",
  "start_urls": [
    {
      "url": "https://tiptap.dev/docs/ai/deprecated/",
      "page_rank": -5
    },
    {
      "url": "https://tiptap.dev/docs/conversion/legacy/",
      "page_rank": -5
    },
    {
      "url": "https://tiptap.dev/docs/resources/changelog",
      "page_rank": -2
    },
    {
      "url": "https://tiptap.dev/docs/ui-components/getting-started/changelog",
      "page_rank": -2
    },
    {
      "url": "https://tiptap.dev/docs/ai/ai-toolkit/client/changelog",
      "page_rank": -2
    },
    "https://tiptap.dev/"
  ],
  "sitemap_urls": ["https://tiptap.dev/sitemap.xml"],
  "sitemap_alternate_links": true,
  "selectors": {
    "default": {
      "lvl0": {
        "selector": "a[data-breadcrumb=\"0\"]",
        "global": true,
        "default_value": "All docs"
      },
      "lvl1": "h1",
      "lvl2": "h2",
      "lvl3": "h3",
      "lvl4": "h4",
      "lvl5": "h5",
      "lvl6": "h6",
      "text": "p, li, td"
    }
  },
  "selectors_exclude": ["pre"],
  "strip_chars": " .,;:#",
  "custom_settings": {
    "separatorsToIndex": "_",
    "attributesForFaceting": ["type", "lang", "version"],
    "attributesToRetrieve": ["hierarchy", "text", "anchor", "url"]
  }
}
