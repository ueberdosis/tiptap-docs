{
  "within": 3,
  "tests": [
    {
      "query": "editor",
      "expect": ["/editor/getting-started/overview"],
      "why": "An area name leads to its overview, not to any page of the area"
    },
    {
      "query": "install",
      "expect": ["/editor/getting-started/install"],
      "why": "The most common first step"
    },
    {
      "query": "react",
      "expect": ["/editor/getting-started/install/react"],
      "why": "Framework names lead to their install guide"
    },
    {
      "query": "setContent",
      "expect": ["/editor/api/commands/content/set-content"],
      "why": "A command by its code name"
    },
    {
      "query": "starter kit",
      "expect": ["/editor/extensions/functionality/starterkit"],
      "why": "Spaced name of StarterKit (synonym)"
    },
    {
      "query": "table",
      "expect": ["/editor/extensions/nodes/table"],
      "why": "An extension by its name"
    },
    {
      "query": "mention",
      "expect": ["/editor/extensions/nodes/mention"],
      "why": "An extension by its name"
    },
    {
      "query": "placeholder",
      "expect": ["/editor/extensions/functionality/placeholder"],
      "why": "An extension by its name"
    },
    {
      "query": "bubble menu",
      "expect": ["/editor/extensions/functionality/bubble-menu"],
      "why": "An extension by its name"
    },
    {
      "query": "node views",
      "expect": ["/editor/extensions/custom-extensions/node-views"],
      "why": "A core concept"
    },
    {
      "query": "custom extension",
      "expect": ["/editor/extensions/custom-extensions"],
      "why": "A core concept"
    },
    {
      "query": "markdown",
      "expect": ["/editor/markdown"],
      "why": "A product area by its name"
    },
    {
      "query": "collaboration provider",
      "expect": ["/collaboration/provider/integration"],
      "why": "Two words from different headings of the same page"
    },
    {
      "query": "snapshot",
      "expect": ["/collaboration/documents/snapshot"],
      "why": "A feature by its name"
    },
    {
      "query": "webhooks",
      "expect": ["/collaboration/core-concepts/webhooks"],
      "why": "A feature by its name"
    },
    {
      "query": "comments rest api",
      "expect": ["/comments/integrate/rest-api"],
      "why": "Area plus API, not another area's REST API"
    },
    {
      "query": "docx import",
      "expect": ["/conversion/import/docx/editor-extension", "/conversion/import/docx/rest-api"],
      "why": "A format and a direction"
    },
    {
      "query": "export pdf",
      "expect": ["/conversion/export/pdf/editor-extension", "/conversion/export/pdf/rest-api"],
      "why": "A format and a direction"
    },
    {
      "query": "ai toolkit",
      "expect": ["/ai/ai-toolkit/overview"],
      "why": "Current product before its deprecated predecessors"
    },
    {
      "query": "tracked changes",
      "expect": ["/tracked-changes/getting-started/overview"],
      "why": "Current product, not the deprecated AI Changes"
    },
    {
      "query": "authentication",
      "expect": ["/authentication"],
      "why": "The current authentication page"
    },
    {
      "query": "track changes",
      "expect": ["/tracked-changes/getting-started/overview"],
      "why": "Word's name (synonym), not AI Changes"
    },
    {
      "query": "history",
      "expect": ["/editor/extensions/functionality/undo-redo", "/collaboration/documents/snapshot"],
      "why": "Renamed in v3 (synonym)"
    },
    {
      "query": "collaboration cursor",
      "expect": ["/editor/extensions/functionality/collaboration-caret"],
      "why": "Renamed in v3 (synonym)"
    },
    {
      "query": "content ai",
      "expect": ["/ai/ai-toolkit/overview"],
      "why": "Old product name (synonym)"
    },
    {
      "query": "ms word",
      "expect": [
        "/conversion/import/docx/editor-extension",
        "/conversion/export/docx/editor-extension",
        "/conversion/content-types/structures-and-media/word-styles"
      ],
      "why": "Word means DOCX (synonym)"
    },
    {
      "query": "accordion",
      "expect": ["/editor/extensions/nodes/details"],
      "why": "Another editor's name (synonym)"
    },
    {
      "query": "content controls",
      "expect": ["/composable-docs/slots/getting-started/overview"],
      "why": "Word's name for slots (synonym)"
    },
    {
      "query": "restricted editing",
      "expect": ["/composable-docs/content-protection/guides/lock-selected-content"],
      "why": "Word's name (synonym)"
    },
    {
      "query": "line spacing",
      "expect": ["/editor/extensions/functionality/line-height"],
      "why": "Word's name (synonym)"
    },
    {
      "query": "paste image",
      "expect": ["/editor/extensions/functionality/filehandler"],
      "why": "A frequent question (synonym)"
    },
    {
      "query": "hotkeys",
      "expect": ["/editor/core-concepts/keyboard-shortcuts"],
      "why": "Another word for shortcuts (synonym)"
    },
    {
      "query": "python",
      "expect": ["/ai/ai-toolkit/client/advanced-guides/non-typescript-backends"],
      "why": "A backend language (synonym)"
    },
    {
      "query": "kommentare",
      "expect": ["/comments/getting-started/overview"],
      "why": "German (synonym)"
    },
    {
      "query": "realtime",
      "expect": [
        "/collaboration/getting-started/install",
        "/collaboration/getting-started/overview"
      ],
      "why": "Spelling of real-time (synonym)"
    }
  ]
}
