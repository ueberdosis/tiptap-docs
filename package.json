{
  "name": "tiptap-docs",
  "version": "0.0.51",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm changelogs && next build --webpack",
    "changelogs": "node --env-file-if-exists=.env.local scripts/changelogs.ts",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "test:search": "node scripts/search/check-ranking.ts",
    "format": "biome format --write",
    "migration:clone": "node migration-scripts/clone-sources.ts",
    "migration:inventory": "node migration-scripts/inventory.ts",
    "migration:inventory:print": "node migration-scripts/inventory-print.ts",
    "migration:import": "node migration-scripts/import.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.103",
    "@ai-sdk/react": "^4.0.0",
    "@base-ui/react": "^1.9.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/base-ui": "16.17.8",
    "@modelcontextprotocol/server": "2.3.1",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "iframe-resizer": "4.4.5",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "remend": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
